# Clerk: the application whose sign-in this site uses. Create one at
# https://dashboard.clerk.com and copy its keys (API keys → Next.js). Both, or
# the site builds without Clerk and shows how to connect it. In a deployed
# environment they are the CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY Orun
# secrets (README → Connect Clerk); never commit them.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The route at which your authentication flow lives, for more information see: https://clerk.com/docs/deployments/clerk-environment-variables
# (next.config.ts defaults it to this; set it only to change it)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Redirect URLs for after authenticating, for more information see: https://clerk.com/docs/guides/custom-redirects
# (next.config.ts defaults them to these)
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Optional. The site's public origin (the Open Graph image's absolute URL);
# the Orun build sets it to the environment's SITE_URL or Worker URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
